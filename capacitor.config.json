{
  "appId": "com.hclc.ownerpulse",
  "appName": "OwnerPulse",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "hostname": "localhost:5173"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#0A0F1E",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}



